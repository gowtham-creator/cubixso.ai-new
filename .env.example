# Email — Resend (https://resend.com). Copy to .env.local for dev, and add the
# same keys in Vercel → Project → Settings → Environment Variables for prod.
# All are OPTIONAL: with none set, the contact + newsletter forms still work and
# just log submissions server-side (visible in `vercel logs`).

# API key from resend.com/api-keys
RESEND_API_KEY=

# Audience id from resend.com/audiences — newsletter signups are added here
RESEND_AUDIENCE_ID=

# Where contact-form enquiries are delivered
CONTACT_TO_EMAIL=contact@cubixso.com

# Sender — MUST be on a domain you've verified in Resend (resend.com/domains).
# Before your domain is verified, leave this blank to use Resend's shared sender.
CONTACT_FROM_EMAIL=Cubixso.ai <noreply@cubixso.ai>

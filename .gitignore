# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude / agent tooling (project-local, not portable)
.agents/
.claude/
skills-lock.json
node-compile-cache/

# Scratch dirs from MCP installers
bunx-*-mcp@latest/

# Local backups + raw uploads (heavy or private)
*.bak
uploads/

# Blender modeling workspace — dev artifacts (~130MB of renders + .blend
# caches). The web app only ships the exported GLB in public/models/.
/blender/

# Playwright / QA scratch (screenshots, traces)
/.playwright-mcp/
/qa-*.jpeg
/qa-*.png

# Stray tool lockfiles
uv-*.lock
.gstack/
